{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Analysis": {
      "additionalProperties": false,
      "properties": {
        "clock_source_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clock Source Id"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/Event"
          },
          "title": "Events",
          "type": "array"
        },
        "summary": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "title": "Summary",
          "type": "array"
        },
        "missing_evidence": {
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "title": "Missing Evidence",
          "type": "array"
        },
        "contradictions": {
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "title": "Contradictions",
          "type": "array"
        },
        "mode": {
          "default": "live",
          "enum": [
            "demo",
            "mock",
            "live",
            "cached"
          ],
          "title": "Mode",
          "type": "string"
        },
        "notice": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notice"
        }
      },
      "required": [
        "events",
        "summary"
      ],
      "title": "Analysis",
      "type": "object"
    },
    "AnalysisRevision": {
      "additionalProperties": false,
      "description": "A previous completed reconstruction and its exact evidence set.",
      "properties": {
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "media_source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Media Source Ids",
          "type": "array"
        },
        "media_count": {
          "minimum": 0,
          "title": "Media Count",
          "type": "integer"
        },
        "media_files": {
          "items": {
            "$ref": "#/$defs/MediaFile"
          },
          "title": "Media Files",
          "type": "array"
        },
        "analysis": {
          "$ref": "#/$defs/Analysis"
        },
        "answers": {
          "items": {
            "$ref": "#/$defs/CaseAnswer"
          },
          "title": "Answers",
          "type": "array"
        },
        "intelligence": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidenceIntelligence"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "revision",
        "created_at",
        "media_source_ids",
        "media_count",
        "analysis"
      ],
      "title": "AnalysisRevision",
      "type": "object"
    },
    "BoxEdges": {
      "additionalProperties": false,
      "properties": {
        "top": {
          "maximum": 1,
          "minimum": 0,
          "title": "Top",
          "type": "number"
        },
        "bottom": {
          "maximum": 1,
          "minimum": 0,
          "title": "Bottom",
          "type": "number"
        },
        "left": {
          "maximum": 1,
          "minimum": 0,
          "title": "Left",
          "type": "number"
        },
        "right": {
          "maximum": 1,
          "minimum": 0,
          "title": "Right",
          "type": "number"
        }
      },
      "required": [
        "top",
        "bottom",
        "left",
        "right"
      ],
      "title": "BoxEdges",
      "type": "object"
    },
    "CaseAnswer": {
      "additionalProperties": false,
      "description": "A user-reported response with the original question retained for provenance.",
      "properties": {
        "answer_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Answer Id",
          "type": "string"
        },
        "question_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Question Id",
          "type": "string"
        },
        "question_title": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Question Title",
          "type": "string"
        },
        "question_text": {
          "maxLength": 12000,
          "minLength": 1,
          "title": "Question Text",
          "type": "string"
        },
        "question_revision": {
          "minimum": 1,
          "title": "Question Revision",
          "type": "integer"
        },
        "text": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "respondent": {
          "default": "",
          "maxLength": 160,
          "title": "Respondent",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "answer_id",
        "question_id",
        "question_title",
        "question_text",
        "question_revision",
        "text",
        "created_at",
        "updated_at"
      ],
      "title": "CaseAnswer",
      "type": "object"
    },
    "CaseMemory": {
      "additionalProperties": false,
      "properties": {
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "entries": {
          "items": {
            "$ref": "#/$defs/MemoryEntry"
          },
          "title": "Entries",
          "type": "array"
        },
        "summary_entry_ids": {
          "items": {
            "type": "string"
          },
          "title": "Summary Entry Ids",
          "type": "array"
        }
      },
      "required": [
        "revision",
        "updated_at"
      ],
      "title": "CaseMemory",
      "type": "object"
    },
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "title": "Source Refs",
          "type": "array"
        },
        "answer_refs": {
          "items": {
            "type": "string"
          },
          "title": "Answer Refs",
          "type": "array"
        }
      },
      "required": [
        "text"
      ],
      "title": "Claim",
      "type": "object"
    },
    "ClaimAssessment": {
      "additionalProperties": false,
      "properties": {
        "claim_index": {
          "minimum": 0,
          "title": "Claim Index",
          "type": "integer"
        },
        "supported_probability": {
          "maximum": 1,
          "minimum": 0,
          "title": "Supported Probability",
          "type": "number"
        },
        "overclaim_probability": {
          "maximum": 1,
          "minimum": 0,
          "title": "Overclaim Probability",
          "type": "number"
        }
      },
      "required": [
        "claim_index",
        "supported_probability",
        "overclaim_probability"
      ],
      "title": "ClaimAssessment",
      "type": "object"
    },
    "DetailedViewReview": {
      "additionalProperties": false,
      "properties": {
        "relationship": {
          "enum": [
            "same_incident_different_view",
            "same_footage",
            "different_incident",
            "uncertain"
          ],
          "title": "Relationship",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "basis": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Basis",
          "type": "string"
        },
        "matches": {
          "items": {
            "$ref": "#/$defs/ViewEventMatch"
          },
          "maxItems": 24,
          "title": "Matches",
          "type": "array"
        },
        "model": {
          "title": "Model",
          "type": "string"
        }
      },
      "required": [
        "relationship",
        "confidence",
        "basis",
        "model"
      ],
      "title": "DetailedViewReview",
      "type": "object"
    },
    "Event": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "source_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Start"
        },
        "source_end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source End"
        },
        "event_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Event Id",
          "type": "string"
        },
        "title": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "description": {
          "maxLength": 12000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "source_type": {
          "$ref": "#/$defs/SourceType"
        },
        "case_min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Case Min"
        },
        "case_best": {
          "title": "Case Best",
          "type": "number"
        },
        "case_max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Case Max"
        },
        "alignment_basis": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Alignment Basis",
          "type": "string"
        },
        "alignment_confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Alignment Confidence",
          "type": "number"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "verification_status": {
          "const": "unverified",
          "default": "unverified",
          "title": "Verification Status",
          "type": "string"
        },
        "evidence_type": {
          "enum": [
            "observation",
            "inference",
            "testimony"
          ],
          "title": "Evidence Type",
          "type": "string"
        },
        "supports": {
          "items": {
            "type": "string"
          },
          "title": "Supports",
          "type": "array"
        }
      },
      "required": [
        "source_id",
        "event_id",
        "title",
        "description",
        "source_type",
        "case_best",
        "alignment_basis",
        "alignment_confidence",
        "confidence",
        "evidence_type"
      ],
      "title": "Event",
      "type": "object"
    },
    "EvidenceIntelligence": {
      "additionalProperties": false,
      "properties": {
        "model": {
          "title": "Model",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "complete",
            "partial",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceIntelligence"
          },
          "title": "Sources",
          "type": "array"
        },
        "claims": {
          "items": {
            "$ref": "#/$defs/ClaimAssessment"
          },
          "title": "Claims",
          "type": "array"
        },
        "video_relationships": {
          "items": {
            "$ref": "#/$defs/VideoRelationship"
          },
          "title": "Video Relationships",
          "type": "array"
        },
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "elapsed_seconds": {
          "default": 0,
          "minimum": 0,
          "title": "Elapsed Seconds",
          "type": "number"
        },
        "diagnostics": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Diagnostics",
          "type": "array"
        }
      },
      "required": [
        "model",
        "version",
        "status"
      ],
      "title": "EvidenceIntelligence",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "title": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "description": {
          "maxLength": 12000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "title": "Source Refs",
          "type": "array"
        },
        "answer_refs": {
          "items": {
            "type": "string"
          },
          "title": "Answer Refs",
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "description"
      ],
      "title": "Finding",
      "type": "object"
    },
    "FrameAssessment": {
      "additionalProperties": false,
      "properties": {
        "source_time": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Time"
        },
        "signals": {
          "additionalProperties": {
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "title": "Signals",
          "type": "object"
        },
        "vehicle_box": {
          "anyOf": [
            {
              "$ref": "#/$defs/BoxEdges"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "box_confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Box Confidence"
        },
        "image_sha256": {
          "default": "",
          "title": "Image Sha256",
          "type": "string"
        },
        "prepared_width": {
          "default": 0,
          "minimum": 0,
          "title": "Prepared Width",
          "type": "integer"
        },
        "prepared_height": {
          "default": 0,
          "minimum": 0,
          "title": "Prepared Height",
          "type": "integer"
        }
      },
      "required": [
        "signals"
      ],
      "title": "FrameAssessment",
      "type": "object"
    },
    "MediaFile": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "filename": {
          "title": "Filename",
          "type": "string"
        },
        "source_type": {
          "$ref": "#/$defs/SourceType"
        },
        "mime_type": {
          "title": "Mime Type",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "duration_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Seconds"
        },
        "captured_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Captured At"
        },
        "metadata": {
          "$ref": "#/$defs/SourceMetadata"
        }
      },
      "required": [
        "source_id",
        "filename",
        "source_type",
        "mime_type",
        "url",
        "sha256",
        "size_bytes"
      ],
      "title": "MediaFile",
      "type": "object"
    },
    "MemoryEntry": {
      "additionalProperties": false,
      "description": "An evidence-linked account, never a private reasoning trace.",
      "properties": {
        "entry_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Entry Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "observation",
            "testimony",
            "inference",
            "summary",
            "question",
            "conflict"
          ],
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "maxLength": 16000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "title": "Source Refs",
          "type": "array"
        },
        "answer_refs": {
          "items": {
            "type": "string"
          },
          "title": "Answer Refs",
          "type": "array"
        },
        "first_revision": {
          "minimum": 1,
          "title": "First Revision",
          "type": "integer"
        },
        "last_revision": {
          "minimum": 1,
          "title": "Last Revision",
          "type": "integer"
        },
        "status": {
          "default": "active",
          "enum": [
            "active",
            "superseded"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "entry_id",
        "kind",
        "text",
        "first_revision",
        "last_revision"
      ],
      "title": "MemoryEntry",
      "type": "object"
    },
    "ReconstructionPreview": {
      "additionalProperties": false,
      "properties": {
        "evidence_revision": {
          "minimum": 1,
          "title": "Evidence Revision",
          "type": "integer"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "analysis": {
          "$ref": "#/$defs/Analysis"
        },
        "intelligence": {
          "$ref": "#/$defs/EvidenceIntelligence"
        }
      },
      "required": [
        "evidence_revision",
        "created_at",
        "analysis",
        "intelligence"
      ],
      "title": "ReconstructionPreview",
      "type": "object"
    },
    "SourceIntelligence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "frames": {
          "items": {
            "$ref": "#/$defs/FrameAssessment"
          },
          "title": "Frames",
          "type": "array"
        },
        "labels": {
          "additionalProperties": {
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "title": "Labels",
          "type": "object"
        }
      },
      "required": [
        "source_id"
      ],
      "title": "SourceIntelligence",
      "type": "object"
    },
    "SourceMetadata": {
      "additionalProperties": false,
      "description": "User-reported context; never substitutes for observed content or EXIF.",
      "properties": {
        "label": {
          "default": "",
          "maxLength": 160,
          "title": "Label",
          "type": "string"
        },
        "recorded_by": {
          "default": "",
          "maxLength": 160,
          "title": "Recorded By",
          "type": "string"
        },
        "location": {
          "default": "",
          "maxLength": 240,
          "title": "Location",
          "type": "string"
        },
        "recorded_at": {
          "default": "",
          "maxLength": 160,
          "title": "Recorded At",
          "type": "string"
        },
        "notes": {
          "default": "",
          "maxLength": 4000,
          "title": "Notes",
          "type": "string"
        }
      },
      "title": "SourceMetadata",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "source_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Start"
        },
        "source_end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source End"
        }
      },
      "required": [
        "source_id"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "SourceType": {
      "enum": [
        "video",
        "audio",
        "photo"
      ],
      "title": "SourceType",
      "type": "string"
    },
    "VideoRelationship": {
      "additionalProperties": false,
      "properties": {
        "source_a": {
          "title": "Source A",
          "type": "string"
        },
        "source_b": {
          "title": "Source B",
          "type": "string"
        },
        "relationship": {
          "enum": [
            "same_incident_different_view",
            "same_footage",
            "different_incident",
            "uncertain"
          ],
          "title": "Relationship",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "same_incident_probability": {
          "maximum": 1,
          "minimum": 0,
          "title": "Same Incident Probability",
          "type": "number"
        },
        "different_view_probability": {
          "maximum": 1,
          "minimum": 0,
          "title": "Different View Probability",
          "type": "number"
        },
        "basis": {
          "title": "Basis",
          "type": "string"
        },
        "matches": {
          "items": {
            "$ref": "#/$defs/ViewEventMatch"
          },
          "title": "Matches",
          "type": "array"
        },
        "detailed_review": {
          "anyOf": [
            {
              "$ref": "#/$defs/DetailedViewReview"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "source_a",
        "source_b",
        "relationship",
        "confidence",
        "same_incident_probability",
        "different_view_probability",
        "basis"
      ],
      "title": "VideoRelationship",
      "type": "object"
