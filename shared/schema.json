{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Analysis": {
      "additionalProperties": false,
      "properties": {
        "events": {
          "items": {
            "$ref": "#/$defs/Event"
          },
          "title": "Events",
          "type": "array"
        },
        "summary": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "title": "Summary",
          "type": "array"
        },
        "missing_evidence": {
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "title": "Missing Evidence",
          "type": "array"
        },
        "contradictions": {
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "title": "Contradictions",
          "type": "array"
        },
        "mode": {
          "default": "live",
          "enum": [
            "demo",
            "mock",
            "live",
            "cached"
          ],
          "title": "Mode",
          "type": "string"
        },
        "notice": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notice"
        }
      },
      "required": [
        "events",
        "summary"
      ],
      "title": "Analysis",
      "type": "object"
    },
    "AnalysisRevision": {
      "additionalProperties": false,
      "description": "A previous completed reconstruction and its exact evidence set.",
      "properties": {
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "media_source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Media Source Ids",
          "type": "array"
        },
        "media_count": {
          "minimum": 0,
          "title": "Media Count",
          "type": "integer"
        },
        "analysis": {
          "$ref": "#/$defs/Analysis"
        }
      },
      "required": [
        "revision",
        "created_at",
        "media_source_ids",
        "media_count",
        "analysis"
      ],
      "title": "AnalysisRevision",
      "type": "object"
    },
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "minItems": 1,
          "title": "Source Refs",
          "type": "array"
        }
      },
      "required": [
        "text",
        "source_refs"
      ],
      "title": "Claim",
      "type": "object"
    },
    "Event": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "source_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Start"
        },
        "source_end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source End"
        },
        "event_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Event Id",
          "type": "string"
        },
        "title": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "description": {
          "maxLength": 12000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "source_type": {
          "$ref": "#/$defs/SourceType"
        },
        "case_min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Case Min"
        },
        "case_best": {
          "title": "Case Best",
          "type": "number"
        },
        "case_max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Case Max"
        },
        "alignment_basis": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Alignment Basis",
          "type": "string"
        },
        "alignment_confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Alignment Confidence",
          "type": "number"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "verification_status": {
          "const": "unverified",
          "default": "unverified",
          "title": "Verification Status",
          "type": "string"
        },
        "evidence_type": {
          "enum": [
            "observation",
            "inference",
            "testimony"
          ],
          "title": "Evidence Type",
          "type": "string"
        },
        "supports": {
          "items": {
            "type": "string"
          },
          "title": "Supports",
          "type": "array"
        }
      },
      "required": [
        "source_id",
        "event_id",
        "title",
        "description",
        "source_type",
        "case_best",
        "alignment_basis",
        "alignment_confidence",
        "confidence",
        "evidence_type"
      ],
      "title": "Event",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "title": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "description": {
          "maxLength": 12000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "title": "Source Refs",
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "description"
      ],
      "title": "Finding",
      "type": "object"
    },
    "MediaFile": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "filename": {
          "title": "Filename",
          "type": "string"
        },
        "source_type": {
          "$ref": "#/$defs/SourceType"
        },
        "mime_type": {
          "title": "Mime Type",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "duration_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Seconds"
        },
        "captured_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Captured At"
        }
      },
      "required": [
        "source_id",
        "filename",
        "source_type",
        "mime_type",
        "url",
        "sha256",
        "size_bytes"
      ],
      "title": "MediaFile",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "source_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Start"
        },
        "source_end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source End"
        }
      },
      "required": [
        "source_id"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "SourceType": {
      "enum": [
        "video",
        "audio",
        "photo"
      ],
      "title": "SourceType",
      "type": "string"
    },
    "Case": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "title": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "media_files": {
          "items": {
            "$ref": "#/$defs/MediaFile"
          },
          "title": "Media Files",
          "type": "array"
        },
        "analysis": {
          "anyOf": [
            {
              "$ref": "#/$defs/Analysis"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence_revision": {
          "default": 1,
          "minimum": 1,
          "title": "Evidence Revision",
          "type": "integer"
        },
        "analyzed_revision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Analyzed Revision"
        },
        "analyzed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Analyzed At"
        },
        "analyzed_source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Analyzed Source Ids",
          "type": "array"
        },
        "analysis_history": {
          "items": {
            "$ref": "#/$defs/AnalysisRevision"
          },
          "title": "Analysis History",
          "type": "array"
        }
      },
      "required": [
        "case_id",
        "title",
        "created_at",
        "media_files"
      ],
      "title": "Case",
      "type": "object"
    },
    "Job": {
      "additionalProperties": false,
      "properties": {
        "job_id": {
          "title": "Job Id",
          "type": "string"
        },
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "completed",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "stage": {
          "enum": [
            "uploading",
            "analyzing_video",
            "analyzing_audio",
            "analyzing_photos",
            "synthesizing",
            "completed",
            "failed"
          ],
          "title": "Stage",
          "type": "string"
        },
        "progress": {
          "maximum": 100,
          "minimum": 0,
          "title": "Progress",
          "type": "integer"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        }
      },
      "required": [
        "job_id",
        "case_id",
        "status",
        "stage",
        "progress"
      ],
      "title": "Job",
      "type": "object"
    },
    "AnalyzeRequest": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "default": "auto",
          "enum": [
            "auto",
            "mock",
            "live"
          ],
          "title": "Mode",
          "type": "string"
        }
      },
      "title": "AnalyzeRequest",
      "type": "object"
    }
  }
}
