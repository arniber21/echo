# Evidence is sent to Gemini only for live analysis. Never commit the real key.
GEMINI_API_KEY=
# Set an available Flash model for your account.
GEMINI_MODEL=gemini-3.8-flash
# auto uses live when configured, otherwise explicitly simulated analysis.
REWIND_ANALYSIS_MODE=auto
# Keep normal workspaces empty. Tests opt in to their own isolated fixture.
REWIND_SEED_DEMO=false

# Jev image/text classification and evidence checks run alongside live analysis.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.14.0
REWIND_TYPESAFE_ENABLED=true
# Bounded full-duration sampling; retains original source timestamps.
REWIND_TYPESAFE_MAX_FRAMES=8
